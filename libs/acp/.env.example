ANTHROPIC_API_KEY=""

# ──────────────────────────────────────────────────────────────────────
# 自定义 Anthropic 协议大模型
# ──────────────────────────────────────────────────────────────────────
#
# ChatAnthropic 自动读取 ANTHROPIC_BASE_URL 和 ANTHROPIC_API_KEY，
# 只需额外指定 ANTHROPIC_MODEL 即可将自定义模型加入 ACP 下拉框。
#
# 环境变量:
#   ANTHROPIC_BASE_URL  — API 地址（ChatAnthropic 自动读取）
#   ANTHROPIC_API_KEY   — API 密钥（ChatAnthropic 自动读取）
#   ANTHROPIC_MODEL     — 模型名称（必填，加入 ACP 下拉框）
#   ANTHROPIC_MODEL_NAME — 下拉框显示名（可选，默认同 MODEL）
#
# 示例（智谱 GLM Anthropic 兼容端点）:
#   ANTHROPIC_BASE_URL="https://open.bigmodel.cn/api/anthropic/v1"
#   ANTHROPIC_API_KEY="your-zhipuai-key"
#   ANTHROPIC_MODEL="glm-4-flash"
#   ANTHROPIC_MODEL_NAME="智谱 GLM-4 (Anthropic)"
#
# ⚠ 注意: ANTHROPIC_BASE_URL 是全局变量，会影响所有 ChatAnthropic 实例。
#   如果同时需要内置 Claude 模型（claude-opus/sonnet/haiku），
#   请改用 CUSTOM_LLM_*_PROTOCOL="anthropic" 方案（通过 ProviderProfile 精确路由，
#   不影响内置模型）。

# Set up LangSmith tracing for your Deep Agent (optional)

# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=""
# LANGSMITH_PROJECT="deepagents-acp"

# ──────────────────────────────────────────────────────────────────────
# 自定义大模型（智谱 GLM / MiniMax / 通义千问 / DeepSeek 等）
# ──────────────────────────────────────────────────────────────────────
#
# 环境变量:
#   CUSTOM_LLM_BASE_URL  — API 地址（必填）
#   CUSTOM_LLM_API_KEY   — API 密钥（必填）
#   CUSTOM_LLM_MODEL     — 模型名称（必填）
#   CUSTOM_LLM_NAME      — ACP 下拉框显示名（可选，默认同 MODEL）
#   CUSTOM_LLM_PROTOCOL  — 协议类型（可选，默认 "openai"）
#                           "openai"     → ChatOpenAI + 自定义 base_url
#                           "anthropic"  → ChatAnthropic + 自定义 base_url
#
# ── OpenAI 兼容 API 示例（大多数国内厂商默认） ──
#
# 智谱 GLM-4-Flash:
#   CUSTOM_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
#   CUSTOM_LLM_API_KEY="your-zhipuai-key"
#   CUSTOM_LLM_MODEL="glm-4-flash"
#   CUSTOM_LLM_NAME="智谱 GLM-4-Flash"
#
# MiniMax:
#   CUSTOM_LLM_BASE_URL="https://api.minimax.chat/v1"
#   CUSTOM_LLM_API_KEY="your-minimax-key"
#   CUSTOM_LLM_MODEL="MiniMax-M1"
#   CUSTOM_LLM_NAME="MiniMax M1"
#
# 通义千问 (DashScope):
#   CUSTOM_LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
#   CUSTOM_LLM_API_KEY="your-dashscope-key"
#   CUSTOM_LLM_MODEL="qwen-plus"
#   CUSTOM_LLM_NAME="通义千问 Plus"
#
# DeepSeek:
#   CUSTOM_LLM_BASE_URL="https://api.deepseek.com/v1"
#   CUSTOM_LLM_API_KEY="your-deepseek-key"
#   CUSTOM_LLM_MODEL="deepseek-chat"
#   CUSTOM_LLM_NAME="DeepSeek Chat"
#
# ── Anthropic 兼容 API 示例 ──
#
#   CUSTOM_LLM_BASE_URL="https://your-anthropic-compatible-endpoint/v1"
#   CUSTOM_LLM_API_KEY="your-api-key"
#   CUSTOM_LLM_MODEL="your-model-name"
#   CUSTOM_LLM_NAME="自定义 Anthropic 模型"
#   CUSTOM_LLM_PROTOCOL="anthropic"
#
# ──────────────────────────────────────────────────────────────────────
# 多模型配置（一个 agent 进程内切换多个自定义模型，编号 1~9）:
#
#   CUSTOM_LLM_1_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
#   CUSTOM_LLM_1_API_KEY="your-zhipuai-key"
#   CUSTOM_LLM_1_MODEL="glm-4-flash"
#   CUSTOM_LLM_1_NAME="智谱 GLM-4"
#
#   CUSTOM_LLM_2_BASE_URL="https://api.minimax.chat/v1"
#   CUSTOM_LLM_2_API_KEY="your-minimax-key"
#   CUSTOM_LLM_2_MODEL="MiniMax-M1"
#   CUSTOM_LLM_2_NAME="MiniMax M1"
#   CUSTOM_LLM_2_PROTOCOL="openai"
#
#   CUSTOM_LLM_3_BASE_URL="https://your-anthropic-endpoint/v1"
#   CUSTOM_LLM_3_API_KEY="your-key"
#   CUSTOM_LLM_3_MODEL="your-model"
#   CUSTOM_LLM_3_NAME="Anthropic 兼容模型"
#   CUSTOM_LLM_3_PROTOCOL="anthropic"
#
# ──────────────────────────────────────────────────────────────────────
# 多 agent 实例（每个终端使用不同 .env 文件）:
#
#   终端 1: ./run_demo_agent.sh 1    # 读取 .env.1
#   终端 2: ./run_demo_agent.sh 2    # 读取 .env.2
